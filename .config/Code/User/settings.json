{
    "vim.easymotion": true,
    "vim.incsearch": true,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.hlsearch": true,
    "vim.surround": true,
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "<C-d>"
            ],
            "after": [
                "<Esc>",
                "l",
                "a"
            ]
        },
        {
            "before": [
                "w",
                "w"
            ],
            "after": [
                "<Esc>",
                "f",
                ")",
                "a"
            ]
        },
        {
            "before": [
                "q",
                "q"
            ],
            "after": [
                "<Esc>",
                "f",
                "}",
                "a"
            ]
        },
        {
            "before": [
                "q",
                "w"
            ],
            "after": [
                "<Esc>",
                "f",
                "]",
                "a"
            ]
        },
        {
            "before": [
                "j",
                "j"
            ],
            "after": [
                "<Esc>"
            ]
        },
        {
            "before": [
                "k",
                "k"
            ],
            "after": [
                "<Esc>"
            ]
        },
        {
            "before": [
                "j",
                "k"
            ],
            "after": [
                "<Esc>",
                "$",
                "a",
                ";",
                "<Esc>"
            ]
        }
    ],
    "vim.visualModeKeyBindings": [
        {
            "before": [
                "K"
            ],
            "after": [
                "5",
                "k"
            ]
        },
        {
            "before": [
                "J"
            ],
            "after": [
                "5",
                "j"
            ]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<C-d>"
            ],
            "after": [
                "<Esc>",
                "l",
                "a"
            ]
        },
        {
            "before": [
                "F",
                "F"
            ],
            "after": [
                "c",
                "i",
                "("
            ]
        },
        {
            "before": [
                "R",
                "R"
            ],
            "after": [
                "c",
                "i",
                "]"
            ]
        },
        {
            "before": [
                "S"
            ],
            "after": [
                "J"
            ]
        },
        {
            "before": [
                "D"
            ],
            "after": [
                "k",
                "J"
            ]
        },
        {
            "before": [
                "K"
            ],
            "after": [
                "5",
                "k"
            ]
        },
        {
            "before": [
                "J"
            ],
            "after": [
                "5",
                "j"
            ]
        },
        {
            "before": [
                "<leader>",
                "d"
            ],
            "after": [
                "d",
                "d"
            ]
        },
        {
            "before": [
                "<C-n>"
            ],
            "commands": [
                ":nohl"
            ]
        },
        {
            "before": [
                "<C-q>"
            ],
            "after": [
                "f",
                ">",
                "a"
            ]
        }
    ],
